{
  "name": "obsidian-task-planner",
  "version": "2.0.6",
  "description": "Turn Markdown tasks across your Obsidian vault into a drag-and-drop planning board for Today, backlog, overdue, and future horizons.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs production",
    "deploy": "cp manifest.json main.js styles.css \"$OBSIDIAN_PATH/.obsidian/plugins/obsidian-task-planner\" && echo 'Deployed to $OBSIDIAN_PATH/.obsidian/plugins/obsidian-task-planner'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run build && node scripts/prepare-e2e-runtime.mjs && wdio run ./wdio.conf.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "preversion": "git diff-index --quiet HEAD -- || (echo 'Error: Working directory not clean. Commit or stash changes first.' && exit 1)",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push && git push --tags",
    "prepare": "simple-git-hooks",
    "audit": "npm audit --audit-level=high"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "keywords": [
    "obsidian",
    "task-management",
    "planning",
    "productivity",
    "todo"
  ],
  "author": "selfish",
  "license": "GPL-2.0",
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint-react/eslint-plugin": "5.18.1",
    "@eslint/json": "0.14.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wdio/cli": "9.28.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.28.0",
    "@wdio/spec-reporter": "9.29.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "esbuild": "0.28.1",
    "esbuild-sass-plugin": "3.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "0.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "17.0.0",
    "moment": "^2.30.0",
    "mocha": "10.8.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "1.97.3",
    "sass-embedded": "1.97.3",
    "simple-git-hooks": "2.13.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.59.2",
    "wdio-obsidian-service": "3.1.1",
    "webdriverio": "9.30.0"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@preact/compat": "^18.3.1",
    "obsidian": "^1.13.1",
    "preact": "^10.28.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfish/obsidian-task-planner.git"
  },
  "bugs": {
    "url": "https://github.com/selfish/obsidian-task-planner/issues"
  },
  "homepage": "https://community.obsidian.md/plugins/task-planner",
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
